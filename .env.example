# Spring API
SPRING_BASE_URL=https://api.deepfence.site
FACESHIELD_INTERNAL_API_KEY=your-secret-api-key

# FaceShield model
FACESHIELD_MODEL_DIR=/home1/ncloud/iccv25_faceshield

# Input / Output (relative to FACESHIELD_MODEL_DIR)
FACESHIELD_INPUT_PATH=data/test/image.png
FACESHIELD_OUTPUT_PATH=results/total_iter30/step_size1.0/noise_clamp12/[image]/protected.png

# Worker
POLL_SECONDS=5
PROCESS_TIMEOUT_SECONDS=1500